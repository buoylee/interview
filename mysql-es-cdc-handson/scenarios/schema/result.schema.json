{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mysql-es-cdc-handson/result.schema.json",
  "$defs": {
    "offsetVector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["0", "1", "2"],
      "properties": {
        "0": {"type": "integer", "minimum": 0},
        "1": {"type": "integer", "minimum": 0},
        "2": {"type": "integer", "minimum": 0}
      }
    },
    "observedRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "topic", "partition", "offset", "next_offset", "run_id", "partition_token", "key_is_null", "record_value_sha256"],
      "properties": {
        "event_id": {"type": "string", "format": "uuid"},
        "topic": {"const": "product-search-revisions"},
        "partition": {"type": "integer", "minimum": 0, "maximum": 2},
        "offset": {"type": "integer", "minimum": 0},
        "next_offset": {"type": "integer", "minimum": 1},
        "run_id": {"type": "string", "format": "uuid"},
        "partition_token": {"enum": ["0", "1", "2"]},
        "key_is_null": {"const": true},
        "record_value_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "observedRecords": {
      "type": "object",
      "additionalProperties": false,
      "required": ["0", "1", "2"],
      "properties": {
        "0": {"$ref": "#/$defs/observedRecord"},
        "1": {"$ref": "#/$defs/observedRecord"},
        "2": {"$ref": "#/$defs/observedRecord"}
      }
    },
    "pipelineState": {"enum": ["HEALTHY", "CATCHING_UP", "DEGRADED", "REBUILD_REQUIRED", "REBUILDING"]}
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "scenario_id", "dependency_versions", "consistency_preconditions",
    "source_watermark", "target_watermarks", "applied_offsets",
    "product_unresolved_dlq_count", "record_unresolved_dlq_count", "unresolved_dlq_count",
    "verification", "exact_diff_count", "tombstone_mismatch_count",
    "canal_position_recovery", "expected_intermediate_states", "observed_intermediate_states",
    "expected_pipeline_state", "observed_pipeline_state", "recovery_action", "requires_rebuild",
    "rebuild_required_before_rebuild", "target_watermark_passed", "result", "started_at", "finished_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "scenario_id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "dependency_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mysql", "canal", "kafka", "elasticsearch", "project_head"],
      "properties": {
        "mysql": {"type": "string", "minLength": 1},
        "canal": {"type": "string", "minLength": 1},
        "kafka": {"type": "string", "minLength": 1},
        "elasticsearch": {"type": "string", "minLength": 1},
        "project_head": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    },
    "consistency_preconditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "satisfied", "observed_at"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "satisfied": {"type": "boolean"},
          "observed_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "source_watermark": {"type": "integer", "minimum": 0},
    "target_watermarks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mysql_revision", "elasticsearch_revision", "passed"],
      "properties": {
        "mysql_revision": {"type": "integer", "minimum": 0},
        "elasticsearch_revision": {"type": "integer", "minimum": 0},
        "passed": {"type": "boolean"}
      }
    },
    "applied_offsets": {"$ref": "#/$defs/offsetVector"},
    "product_unresolved_dlq_count": {"type": "integer", "minimum": 0},
    "record_unresolved_dlq_count": {"type": "integer", "minimum": 0},
    "unresolved_dlq_count": {"type": "integer", "minimum": 0},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "status", "conclusive", "stable", "exact_managed_field_diff_count", "version_metadata_diff_count", "observed_at"],
      "properties": {
        "run_id": {"type": "string", "format": "uuid"},
        "status": {"enum": ["PASS", "DIFF", "INCONCLUSIVE"]},
        "conclusive": {"type": "boolean"},
        "stable": {"type": "boolean"},
        "exact_managed_field_diff_count": {"type": "integer", "minimum": 0},
        "version_metadata_diff_count": {"type": "integer", "minimum": 0},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    },
    "exact_diff_count": {"type": "integer", "minimum": 0},
    "tombstone_mismatch_count": {"type": "integer", "minimum": 0},
    "canal_position_recovery": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "old_cursor_sha256", "old_missing_journal", "old_missing_position", "retained_binlog_files",
            "reset_lower_bound_journal", "reset_lower_bound_file_index", "reset_lower_bound_position",
            "reset_cursor_sha256", "reset_journal", "reset_file_index", "reset_position",
            "reset_anchor_run_id", "reset_anchor_next_offsets", "reset_anchor_events", "reset_restart_offsets_before",
            "normal_restart_cursor_sha256", "normal_restart_journal", "normal_restart_file_index", "normal_restart_position",
            "normal_restart_offsets_after", "normal_restart_preserved", "normal_sentinel_run_id",
            "normal_sentinel_next_offsets", "normal_sentinel_events"
          ],
          "properties": {
            "old_cursor_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "old_missing_journal": {"type": "string", "pattern": "^binlog\\.[0-9]{6}$"},
            "old_missing_position": {"type": "integer", "minimum": 4},
            "retained_binlog_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^binlog\\.[0-9]{6}$"}},
            "reset_lower_bound_journal": {"type": "string", "pattern": "^binlog\\.[0-9]{6}$"},
            "reset_lower_bound_file_index": {"type": "integer", "minimum": 0},
            "reset_lower_bound_position": {"type": "integer", "minimum": 4},
            "reset_cursor_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "reset_journal": {"type": "string", "pattern": "^binlog\\.[0-9]{6}$"},
            "reset_file_index": {"type": "integer", "minimum": 0},
            "reset_position": {"type": "integer", "minimum": 4},
            "reset_anchor_run_id": {"type": "string", "format": "uuid"},
            "reset_anchor_next_offsets": {"$ref": "#/$defs/offsetVector"},
            "reset_anchor_events": {"$ref": "#/$defs/observedRecords"},
            "reset_restart_offsets_before": {"$ref": "#/$defs/offsetVector"},
            "normal_restart_cursor_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "normal_restart_journal": {"type": "string", "pattern": "^binlog\\.[0-9]{6}$"},
            "normal_restart_file_index": {"type": "integer", "minimum": 0},
            "normal_restart_position": {"type": "integer", "minimum": 4},
            "normal_restart_offsets_after": {"$ref": "#/$defs/offsetVector"},
            "normal_restart_preserved": {"const": true},
            "normal_sentinel_run_id": {"type": "string", "format": "uuid"},
            "normal_sentinel_next_offsets": {"$ref": "#/$defs/offsetVector"},
            "normal_sentinel_events": {"$ref": "#/$defs/observedRecords"}
          }
        }
      ]
    },
    "expected_intermediate_states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/pipelineState"}},
    "observed_intermediate_states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/pipelineState"}},
    "expected_pipeline_state": {"$ref": "#/$defs/pipelineState"},
    "observed_pipeline_state": {"$ref": "#/$defs/pipelineState"},
    "recovery_action": {"type": "string", "minLength": 1},
    "requires_rebuild": {"type": "boolean"},
    "rebuild_required_before_rebuild": {"type": "boolean"},
    "target_watermark_passed": {"type": "boolean"},
    "result": {"enum": ["PASS", "FAIL"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "PASS"}}, "required": ["result"]},
      "then": {
        "properties": {
          "target_watermark_passed": {"const": true},
          "product_unresolved_dlq_count": {"const": 0},
          "record_unresolved_dlq_count": {"const": 0},
          "unresolved_dlq_count": {"const": 0},
          "exact_diff_count": {"const": 0},
          "tombstone_mismatch_count": {"const": 0},
          "verification": {
            "properties": {
              "status": {"const": "PASS"},
              "conclusive": {"const": true},
              "stable": {"const": true},
              "exact_managed_field_diff_count": {"const": 0},
              "version_metadata_diff_count": {"const": 0}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"requires_rebuild": {"const": true}}, "required": ["requires_rebuild"]},
      "then": {"properties": {"rebuild_required_before_rebuild": {"const": true}}}
    }
  ]
}
