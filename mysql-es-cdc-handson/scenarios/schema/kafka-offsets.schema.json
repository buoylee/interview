{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "offset": {"type":"object","additionalProperties":false,"required":["partition","offset"],"properties":{"partition":{"type":"integer","minimum":0,"maximum":2},"offset":{"type":"integer","minimum":0}}},
    "primary": {"type":"object","additionalProperties":false,"required":["partition","offset","lag"],"properties":{"partition":{"type":"integer","minimum":0,"maximum":2},"offset":{"type":["integer","null"],"minimum":0},"lag":{"type":["integer","null"],"minimum":0}}},
    "shadow": {"type":"object","additionalProperties":false,"required":["run_id","phase","partition_id","next_offset"],"properties":{"run_id":{"type":"string","format":"uuid"},"phase":{"enum":["START","SHADOW","BARRIER"]},"partition_id":{"type":"integer","minimum":0,"maximum":2},"next_offset":{"type":"integer","minimum":0}}},
    "offsetArray":{"type":"array","minItems":3,"maxItems":3,"uniqueItems":true,"items":{"$ref":"#/$defs/offset"},"allOf":[{"contains":{"properties":{"partition":{"const":0}},"required":["partition"]},"minContains":1,"maxContains":1},{"contains":{"properties":{"partition":{"const":1}},"required":["partition"]},"minContains":1,"maxContains":1},{"contains":{"properties":{"partition":{"const":2}},"required":["partition"]},"minContains":1,"maxContains":1}]},
    "primaryArray":{"type":"array","minItems":3,"maxItems":3,"uniqueItems":true,"items":{"$ref":"#/$defs/primary"},"allOf":[{"contains":{"properties":{"partition":{"const":0}},"required":["partition"]},"minContains":1,"maxContains":1},{"contains":{"properties":{"partition":{"const":1}},"required":["partition"]},"minContains":1,"maxContains":1},{"contains":{"properties":{"partition":{"const":2}},"required":["partition"]},"minContains":1,"maxContains":1}]},
    "shadowArray":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/shadow"},"oneOf":[{"maxItems":0},{"minItems":9,"allOf":[{"contains":{"properties":{"phase":{"const":"START"},"partition_id":{"const":0}},"required":["phase","partition_id"]}},{"contains":{"properties":{"phase":{"const":"START"},"partition_id":{"const":1}},"required":["phase","partition_id"]}},{"contains":{"properties":{"phase":{"const":"START"},"partition_id":{"const":2}},"required":["phase","partition_id"]}},{"contains":{"properties":{"phase":{"const":"SHADOW"},"partition_id":{"const":0}},"required":["phase","partition_id"]}},{"contains":{"properties":{"phase":{"const":"SHADOW"},"partition_id":{"const":1}},"required":["phase","partition_id"]}},{"contains":{"properties":{"phase":{"const":"SHADOW"},"partition_id":{"const":2}},"required":["phase","partition_id"]}},{"contains":{"properties":{"phase":{"const":"BARRIER"},"partition_id":{"const":0}},"required":["phase","partition_id"]}},{"contains":{"properties":{"phase":{"const":"BARRIER"},"partition_id":{"const":1}},"required":["phase","partition_id"]}},{"contains":{"properties":{"phase":{"const":"BARRIER"},"partition_id":{"const":2}},"required":["phase","partition_id"]}}]}]},
    "offsetVector": {"type":"object","additionalProperties":false,"required":["0","1","2"],"properties":{"0":{"type":"integer","minimum":0},"1":{"type":"integer","minimum":0},"2":{"type":"integer","minimum":0}}},
    "event": {"type":"object","additionalProperties":false,"required":["event_id","topic","partition","offset","next_offset","run_id","partition_token","key_is_null","record_value_sha256"],"properties":{"event_id":{"type":"string","format":"uuid"},"topic":{"const":"product-search-revisions"},"partition":{"type":"integer","minimum":0,"maximum":2},"offset":{"type":"integer","minimum":0},"next_offset":{"type":"integer","minimum":1},"run_id":{"type":"string","format":"uuid"},"partition_token":{"enum":["0","1","2"]},"key_is_null":{"const":true},"record_value_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},
    "events": {"type":"object","additionalProperties":false,"required":["0","1","2"],"properties":{"0":{"$ref":"#/$defs/event"},"1":{"$ref":"#/$defs/event"},"2":{"$ref":"#/$defs/event"}}},
    "recoveryObservation": {"type":"object","additionalProperties":false,"required":["events","next_offsets"],"properties":{"events":{"$ref":"#/$defs/events"},"next_offsets":{"$ref":"#/$defs/offsetVector"}}}
  },
  "oneOf": [
    {
      "type":"object","additionalProperties":false,
      "required":["schema_version","scenario_id","runner_run_id","consistency","documents"],
      "properties":{"schema_version":{"const":1},"scenario_id":{"type":"string","pattern":"^[a-z0-9]+(-[a-z0-9]+)*$"},"runner_run_id":{"type":"string","format":"uuid"},"consistency":{"const":"FAIL_CLOSED_CAPTURE"},"documents":{"type":"array","maxItems":0}}
    },
    {
      "type":"object","additionalProperties":false,
      "required":["schema_version","scenario_id","runner_run_id","consistency","topic","beginning","end","primary","shadow_and_barrier"],
      "properties":{"schema_version":{"const":1},"scenario_id":{"type":"string","pattern":"^[a-z0-9]+(-[a-z0-9]+)*$"},"runner_run_id":{"type":"string","format":"uuid"},"consistency":{"const":"ADMIN_OFFSETS_AT_CAPTURE_TIME"},"topic":{"const":"product-search-revisions"},"beginning":{"$ref":"#/$defs/offsetArray"},"end":{"$ref":"#/$defs/offsetArray"},"primary":{"$ref":"#/$defs/primaryArray"},"shadow_and_barrier":{"$ref":"#/$defs/shadowArray"},"raw_recovery_observations":{"type":"object","additionalProperties":false,"required":["reset_anchor","normal_sentinel"],"properties":{"reset_anchor":{"$ref":"#/$defs/recoveryObservation"},"normal_sentinel":{"$ref":"#/$defs/recoveryObservation"}}}}
    }
  ]
}
