    "verificationCommand":{"type":"object","additionalProperties":false,"required":["sequence","execution","intent_phases","kind","target","method","path","body_sha256","fixture_path","fixture_sha256","started_at","finished_at","exit_code"],"properties":{"sequence":{"const":3},"execution":{"const":"verification"},"intent_phases":{"const":["verification"]},"kind":{"const":"HTTP"},"target":{"const":"consistency-verifier"},"method":{"const":"POST"},"path":{"const":"/internal/reconciliation/runs"},"body_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"fixture_path":{"const":"scenarios/scripts/collect-m6-observations.sh"},"fixture_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"started_at":{"type":"string","format":"date-time"},"finished_at":{"type":"string","format":"date-time"},"exit_code":{"type":"integer","minimum":0,"maximum":255}}},
    "runtimeCommand":{"type":"object","additionalProperties":false,"required":["sequence","kind","target","method","path","started_at","finished_at","exit_code"],"properties":{"sequence":{"type":"integer","minimum":1},"kind":{"enum":["HTTP","SQL_FIXTURE","CONTROL"]},"target":{"type":"string","minLength":1},"method":{"enum":["GET","POST","PUT","PATCH","DELETE","EXECUTE"]},"path":{"type":"string","pattern":"^/(?!.*[.][.])"},"started_at":{"type":"string","format":"date-time"},"finished_at":{"type":"string","format":"date-time"},"exit_code":{"type":"integer","minimum":0,"maximum":255}}},
    "cleanup":{"type":"object","additionalProperties":false,"required":["name","success","finished_at"],"properties":{"name":{"type":"string","minLength":1},"success":{"type":"boolean"},"finished_at":{"type":"string","format":"date-time"}}},
