    "canalRecovery":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["old_cursor_sha256","old_missing_journal","old_missing_position","retained_binlog_files","reset_lower_bound_journal","reset_lower_bound_file_index","reset_lower_bound_position","reset_cursor_sha256","reset_journal","reset_file_index","reset_position","reset_anchor_run_id","reset_anchor_next_offsets","reset_anchor_events","reset_restart_offsets_before","normal_restart_cursor_sha256","normal_restart_journal","normal_restart_file_index","normal_restart_position","normal_restart_offsets_after","normal_restart_preserved","normal_sentinel_run_id","normal_sentinel_next_offsets","normal_sentinel_events"],"properties":{"old_cursor_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"old_missing_journal":{"type":"string","pattern":"^(binlog|mysql-bin)\\.[0-9]{6}$"},"old_missing_position":{"type":"integer","minimum":4},"retained_binlog_files":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^(binlog|mysql-bin)\\.[0-9]{6}$"}},"reset_lower_bound_journal":{"type":"string","pattern":"^(binlog|mysql-bin)\\.[0-9]{6}$"},"reset_lower_bound_file_index":{"type":"integer","minimum":0},"reset_lower_bound_position":{"type":"integer","minimum":4},"reset_cursor_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"reset_journal":{"type":"string","pattern":"^(binlog|mysql-bin)\\.[0-9]{6}$"},"reset_file_index":{"type":"integer","minimum":0},"reset_position":{"type":"integer","minimum":4},"reset_anchor_run_id":{"type":"string","format":"uuid"},"reset_anchor_next_offsets":{"$ref":"#/$defs/offsetVector"},"reset_anchor_events":{"$ref":"#/$defs/observedRecords"},"reset_restart_offsets_before":{"$ref":"#/$defs/offsetVector"},"normal_restart_cursor_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"normal_restart_journal":{"type":"string","pattern":"^(binlog|mysql-bin)\\.[0-9]{6}$"},"normal_restart_file_index":{"type":"integer","minimum":0},"normal_restart_position":{"type":"integer","minimum":4},"normal_restart_offsets_after":{"$ref":"#/$defs/offsetVector"},"normal_restart_preserved":{"const":true},"normal_sentinel_run_id":{"type":"string","format":"uuid"},"normal_sentinel_next_offsets":{"$ref":"#/$defs/offsetVector"},"normal_sentinel_events":{"$ref":"#/$defs/observedRecords"}}}]},
    "observations":{"type":"object","additionalProperties":false,"required":["consistency_preconditions","source_watermark","target_watermarks","watermark_run_id","applied_offsets","scenario_lag_satisfied","product_unresolved_dlq_count","record_unresolved_dlq_count","verification","exact_diff_count","tombstone_mismatch_count","canal_position_recovery","observed_intermediate_states","observed_pipeline_state","recovery_action_observed","rebuild_required_before_rebuild","commands","recovery_commands","cleanup_actions","runner_failures"],"properties":{"consistency_preconditions":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/precondition"}},"source_watermark":{"type":"integer","minimum":0},"target_watermarks":{"$ref":"#/$defs/targetWatermarks"},"watermark_run_id":{"type":"string","format":"uuid"},"applied_offsets":{"$ref":"#/$defs/offsetVector"},"scenario_lag_satisfied":{"type":"boolean"},"product_unresolved_dlq_count":{"type":"integer","minimum":0},"record_unresolved_dlq_count":{"type":"integer","minimum":0},"verification":{"$ref":"#/$defs/verification"},"exact_diff_count":{"type":"integer","minimum":0},"tombstone_mismatch_count":{"type":"integer","minimum":0},"canal_position_recovery":{"$ref":"#/$defs/canalRecovery"},"observed_intermediate_states":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["HEALTHY","CATCHING_UP","DEGRADED","REBUILD_REQUIRED","REBUILDING"]}},"observed_pipeline_state":{"enum":["HEALTHY","CATCHING_UP","DEGRADED","REBUILD_REQUIRED","REBUILDING"]},"recovery_action_observed":{"type":"boolean"},"rebuild_required_before_rebuild":{"type":"boolean"},"commands":{"type":"array","maxItems":1,"items":{"oneOf":[{"$ref":"#/$defs/verificationCommand"},{"$ref":"#/$defs/runtimeCommand"}]}},"recovery_commands":{"type":"array","items":{"$ref":"#/$defs/runtimeCommand"}},"cleanup_actions":{"type":"array","items":{"$ref":"#/$defs/cleanup"}},"runner_failures":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}}},
    "independentVerification":{"type":"object","additionalProperties":false,"required":["runId","target","status","sourceWatermarkStart","sourceWatermarkEnd","expectedCount","actualCount","differenceCount","counts","failureClass","failureMessage"],"properties":{"runId":{"type":"string","format":"uuid"},"target":{"const":"products_write"},"status":{"enum":["PASS","DIFF","INCONCLUSIVE"]},"sourceWatermarkStart":{"type":"integer","minimum":0},"sourceWatermarkEnd":{"type":"integer","minimum":0},"expectedCount":{"type":"integer","minimum":0},"actualCount":{"type":"integer","minimum":0},"differenceCount":{"type":"integer","minimum":0},"counts":{"type":"object","additionalProperties":false,"required":["MISSING","UNEXPECTED","MODIFIED","TOMBSTONE_MISMATCH","VERSION_METADATA_MISMATCH"],"properties":{"MISSING":{"type":"integer","minimum":0},"UNEXPECTED":{"type":"integer","minimum":0},"MODIFIED":{"type":"integer","minimum":0},"TOMBSTONE_MISMATCH":{"type":"integer","minimum":0},"VERSION_METADATA_MISMATCH":{"type":"integer","minimum":0}}},"failureClass":{"type":["string","null"]},"failureMessage":{"type":["string","null"]}}}
