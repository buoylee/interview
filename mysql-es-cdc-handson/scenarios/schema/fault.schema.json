{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["schema_version","scenario_id","runner_run_id","declared_fault","cleanup_registered_before_fault"],
  "properties":{
    "schema_version":{"const":1},"scenario_id":{"type":"string","pattern":"^[a-z0-9]+(-[a-z0-9]+)*$"},"runner_run_id":{"type":"string","format":"uuid"},
    "declared_fault":{"oneOf":[{"type":"object","additionalProperties":false,"required":["type","target","action"],"properties":{"type":{"type":"string","minLength":1},"target":{"type":"string","minLength":1},"action":{"type":"string","minLength":1}}},{"type":"object","additionalProperties":false,"required":["type"],"properties":{"type":{"const":"fixture"}}}]},
    "cleanup_registered_before_fault":{"type":"boolean"},
    "observed_intermediate_states":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["HEALTHY","CATCHING_UP","DEGRADED","REBUILD_REQUIRED","REBUILDING"]}},
    "case_observations":{"type":"object","additionalProperties":false,"required":["scenario_id","artifacts"],"properties":{"scenario_id":{"type":"string"},"artifacts":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/artifact"}}}}
  },
  "$defs":{"artifact":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","pattern":"^(?!/)(?!.*[.][.]/)[a-zA-Z0-9._/-]+$"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"json":{},"text":{"type":"string"}},"oneOf":[{"required":["json"]},{"required":["text"]}]}}
}
