{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$defs":{
    "intent":{"type":"object","additionalProperties":false,"required":["sequence","intent_phase","kind","target","method","path","fixture_path","fixture_sha256"],"properties":{"sequence":{"type":"integer","minimum":1,"maximum":3},"intent_phase":{"enum":["business-mutation","fault","recovery"]},"kind":{"enum":["HTTP","SQL_FIXTURE","CONTROL"]},"target":{"type":"string","minLength":1},"method":{"enum":["GET","POST","PUT","PATCH","DELETE","EXECUTE"]},"path":{"type":"string","pattern":"^/(?!.*[.][.])"},"fixture_path":{"type":"string","pattern":"^scenarios/scripts/cases/[0-9]{2}-[a-z0-9-]+[.]sh$"},"fixture_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},
    "execution":{"type":"object","additionalProperties":false,"required":["sequence","execution","intent_phases","kind","target","method","path","fixture_path","fixture_sha256","started_at","finished_at","exit_code"],"properties":{"sequence":{"type":"integer","minimum":1,"maximum":3},"execution":{"enum":["mutate","recovery","verification"]},"intent_phases":{"oneOf":[{"const":["business-mutation","fault"]},{"const":["recovery"]},{"const":["verification"]}]},"kind":{"enum":["HTTP","SQL_FIXTURE","CONTROL"]},"target":{"type":"string","minLength":1},"method":{"enum":["GET","POST","PUT","PATCH","DELETE","EXECUTE"]},"path":{"type":"string","pattern":"^/(?!.*[.][.])"},"body_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"fixture_path":{"type":"string","pattern":"^(scenarios|tests)/[a-zA-Z0-9._/-]+$"},"fixture_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"started_at":{"type":"string","format":"date-time"},"finished_at":{"type":"string","format":"date-time"},"exit_code":{"type":"integer","minimum":0,"maximum":255}}}
  },
  "type":"object","additionalProperties":false,"required":["schema_version","scenario_id","runner_run_id","intents","executions"],
  "properties":{"schema_version":{"const":1},"scenario_id":{"type":"string","pattern":"^[a-z0-9]+(-[a-z0-9]+)*$"},"runner_run_id":{"type":"string","format":"uuid"},"intents":{"type":"array","maxItems":3,"items":{"$ref":"#/$defs/intent"}},"executions":{"type":"array","maxItems":3,"items":{"$ref":"#/$defs/execution"}}}
}
