{
  "$defs": {
    "CreateOrderItem": {
      "additionalProperties": false,
      "properties": {
        "quantity": {
          "maximum": 100,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "sku": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Sku",
          "type": "string"
        },
        "unit_price": {
          "$ref": "#/$defs/Money"
        }
      },
      "required": [
        "sku",
        "quantity",
        "unit_price"
      ],
      "title": "CreateOrderItem",
      "type": "object"
    },
    "Money": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "pattern": "^(?:[1-9][0-9]{0,9}(?:\\.[0-9]{1,2})?|0\\.(?:0[1-9]|[1-9][0-9]?))$",
          "title": "Amount",
          "type": "string"
        },
        "currency": {
          "pattern": "^[\\u0009-\\u000D ]*[A-Za-z]{3}[\\u0009-\\u000D ]*$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Money",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "customer_id": {
      "pattern": "^cus_[0-9a-f]{12}$",
      "title": "Customer Id",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 64,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9._-]+$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/CreateOrderItem"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "customer_id",
    "idempotency_key",
    "items"
  ],
  "title": "CreateOrderRequest",
  "type": "object"
}
